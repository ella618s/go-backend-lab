# 複製成 .env 後填入實際值，.env 不可提交到 Git
# 至少 32 字元的隨機字串，例如：openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string

# Docker Compose 使用的 PostgreSQL 設定（密碼請用 openssl rand -hex 16，避免特殊字元）
POSTGRES_PASSWORD=replace-me
# POSTGRES_USER=app
# POSTGRES_DB=appdb

# 選填（不使用 Docker Compose、直接 go run 時）
# DB_PATH=app.db
# PORT=8080
# DATABASE_URL=postgres://app:密碼@localhost:5432/appdb?sslmode=disable